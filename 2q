#include "codexion.h"

void    init_queue(t_pq *q,  int (*cmp)(t_request *, t_request *))
{
    q->head = NULL;
    q->size = 0;
    q->cmp = cmp;
}

t_request peek(t_pq *q)
{
    return (q->head->req);
}

void swap(t_request *a, t_request *b)
{
    t_request temp;

    temp = *a;
    *a = *b;
    *b = temp;
}

t_node *get_node(t_node *node , int n)
{
    t_node	*found;

    if (!node)
        return (NULL);
    if (node->index == n)
        return (node);
    found = get_node(node->left, n);
    if (found)
        return (found);
    return (get_node(node->right, n));
}

void shift_up(t_pq *q, t_node *node)
{
    while(node->parent  && q->cmp(&node->parent->req, &node->req) < 0)
    {
        swap(&node, &node->parent);
        node=node->parent;
    }
}
void insert (t_pq *q, t_request req)
{
    t_node *node;
    t_node *parent;
    int n;

    node = malloc(sizeof(t_node));
    if (!node)
        return ;
    node->req =req;
    node->left =NULL;
    node->right = NULL;
    node->parent = NULL;
    
    if (q->size==0)
        q->head=node;
    else
    {
        n = q->size + 1;
        parent=get_node(q, n / 2);
        node->parent = parent;
		if (n % 2 == 0)               /* even → left child */
			parent->left = node;
		else                          /* odd  → right child */
			parent->right = node;
    }
        q->size++;
        shift_up(q, node);
        return;
}

